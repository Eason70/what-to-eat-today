# JS API 浏览器 Key（公开标识，必须设置域名白名单）
AMAP_JS_KEY=
# 以下两项只留在服务器，不得发送给浏览器
AMAP_SECURITY_JS_CODE=
AMAP_WEB_SERVICE_KEY=
# 未核实评分量纲时留空；得到高德/账户实际接口依据后才能填 5
AMAP_RATING_SCALE=
# 本地仅监听回环；生产由同机 Caddy 提供 HTTPS
HOST=127.0.0.1
PORT=4173
# 生产必填 HTTPS 源地址，不带路径或结尾斜杠
PUBLIC_ORIGIN=
# 只在同机反向代理且其覆盖 X-Forwarded-For 时启用
TRUST_PROXY=false
