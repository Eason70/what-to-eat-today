{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "what-to-eat-today",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/_AMapService/*"]
  },
  "vars": { "AMAP_ENABLED": "true" },
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
