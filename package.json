{
  "name": "what-to-eat-today",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "node scripts/build.mjs",
    "check:build": "node --env-file-if-exists=.env scripts/check-build.mjs",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "preview": "node --env-file-if-exists=.env scripts/preview.mjs",
    "test": "node --test tests/unit/*.test.js tests/server/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run build && npm run check:build && npm run test:e2e",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy:cloudflare": "npm run build && npm run check:build && wrangler deploy",
    "types:cloudflare": "wrangler types",
    "build:pages": "npm run build && npm run check:build && node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260924.1",
    "@playwright/test": "^1.63.0",
    "wrangler": "4.137.0"
  }
}
